{
  "include": [
    ".claude/hooks/**/*.py",
    "packages/cli/src/templates/**/*.py"
  ],
  "exclude": ["**/node_modules", "**/__pycache__", "dist"],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.9",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedVariable": true,
  "reportUnusedImport": "warning"
}
