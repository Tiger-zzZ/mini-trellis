pnpm lint-staged

# Git sets GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE/GIT_COMMON_DIR for the hook's
# own process so it can operate on the commit-in-progress. Some integration
# tests shell out to `git` inside their own tmp fixture repos; without
# unsetting these first, those nested git calls inherit this repo's real
# coordinates instead of the fixture's.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

pnpm test
